# ============================================================
#  PredictieScor - variabile de mediu
#  Copiaza acest fisier in ".env" si completeaza valorile.
# ============================================================

# --- API-Football (api-sports.io) -----------------------------
# Cont gratuit: https://dashboard.api-football.com/register  (100 req/zi)
# SAU prin RapidAPI: https://rapidapi.com/api-sports/api/api-football
APIFOOTBALL_KEY=
# "direct" pentru api-sports.io, "rapidapi" pentru RapidAPI
APIFOOTBALL_HOST=direct

# --- Sofascore (API neoficial, fara cheie) --------------------
SOFASCORE_ENABLED=true

# --- FBref (scraping, fara cheie) -----------------------------
FBREF_ENABLED=true

# --- Flashscore: scor live (fara cheie) -----------------------
FLASHSCORE_ENABLED=true
# Cote pre-meci de la Flashscore (endpoint nedocumentat - vezi README)
FLASHSCORE_ODDS=true

# --- Stiri din fluxuri RSS (fara cheie) -----------------------
NEWS_ENABLED=true

# --- LPF.ro, site-ul oficial al ligii (fara cheie) ------------
LPF_ENABLED=true

# --- Transfermarkt (scraping, fara cheie) ---------------------
TRANSFERMARKT_ENABLED=true

# --- football-data.co.uk (CSV gratuit, fara cheie) ------------
FOOTBALLDATA_ENABLED=true

# --- Comportament general -------------------------------------
# Secunde intre request-uri catre acelasi provider (politete / anti-ban)
SCRAPE_DELAY=3.0
# Ore cat timp raspunsurile HTTP raman valide in cache
HTTP_CACHE_TTL_HOURS=12
